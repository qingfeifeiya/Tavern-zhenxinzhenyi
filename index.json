  PD.body.appendChild(host);

  // 悬浮球
  /** 按 ID 获取当前实例 Shadow DOM 中的控件。 */
  const $ = id => sh.getElementById(id);
  const fabWrap = $('fabWrap'), fabBall = $('fabBall'), fabMenu = $('fabMenu');
  let pluginEnabled = readPluginEnabled(), dragState = null;
  let fabDragged = false;

  /** 按可见状态更新悬浮菜单和展开状态，供指针、键盘及关闭面板时恢复焦点使用。 */
  const setFabMenu = visible => {
    fabMenu.hidden = !visible;
    fabBall.setAttribute('aria-expanded', String(visible));
  };

  /** 处理主按钮按下的指针事件，记录起点并捕获指针。 */
  fabBall.addEventListener('pointerdown', e => {
    if (e.button !== 0) return;
    fabDragged = false;
    const r = fabWrap.getBoundingClientRect();
    dragState = { sx: e.clientX, sy: e.clientY, l: r.left, t: r.top, moved: false };
    fabBall.setPointerCapture(e.pointerId);
  }, listenerOptions);
  /** 根据移动事件计算边界内的位置，保留 5 像素的拖拽阈值。 */
  fabBall.addEventListener('pointermove', e => {
    if (!dragState) return;
    const dx = e.clientX - dragState.sx, dy = e.clientY - dragState.sy;
    if (Math.hypot(dx, dy) > 5) dragState.moved = true;
    if (!dragState.moved) return;
    const nl = Math.min(P.innerWidth - 52, Math.max(8, dragState.l + dx));
    const nt = Math.min(P.innerHeight - 52, Math.max(8, dragState.t + dy));
    Object.assign(fabWrap.style, { left: nl + 'px', top: nt + 'px', bottom: 'auto' });
    fabWrap.classList.toggle('right-side', nl > P.innerWidth / 2);
  }, listenerOptions);
  /** 捕获结束时记录是否拖动，下一次 click 据此忽略拖动产生的点击。 */
  fabBall.addEventListener('lostpointercapture', () => {
    fabDragged = Boolean(dragState?.moved);
    dragState = null;
  }, listenerOptions);

  /** 原生 click 同时覆盖指针、键盘和辅助技术，拖拽结束时保持菜单不变。 */
  fabBall.addEventListener('click', e => {
    if (e.detail === 0 || !fabDragged) setFabMenu(fabMenu.hidden);
  }, listenerOptions);

  // 面板与搭配台
  const overlay = $('overlay'), panel = $('panel'), gwrap = $('gwrap'), gwrapBar = $('gwrapBar'), grid = $('grid'), kanbanBoard = $('kanbanBoard');
  const narrowLayout = P.matchMedia('(max-width: 960px)');
  const closePanelButton = panel.querySelector('[data-ui="close"]');
  const panelOpenNotice = $('panelOpenNotice');
  const backButton = panel.querySelector('[data-ui="close-detail"]');
  const addOutfitForm = $('addOutfitForm');
  const wardrobeSelect = $('wbSelect');
  const wardrobeDialog = $('modalWardrobeMgr');
  const wardrobeList = $('wardrobeList');
  const wardrobeDeleteDialog = $('modalWardrobeDelete');
  wardrobeDeleteDialog.setAttribute('role', 'alertdialog');
  wardrobeDeleteDialog.setAttribute('aria-describedby', 'wardrobeDeletePrompt wardrobeDeleteDetails');
  const createName = $('wardrobeCreateName');
  const wardrobeGroupList = $('wardrobeGroupList');
  const wardrobeGroupForm = $('wardrobeGroupForm');
  const wardrobeGroupName = $('wardrobeGroupName');
  const wardrobeGroupMembers = $('wardrobeGroupMembers');
  const batchMoveDialog = $('modalBatchMove');
  const settingsDialog = $('modalSettings');
  const settingsFields = [...settingsDialog.querySelectorAll('[data-setting]')];
  // 每个服饰 ID 关联已挂载的卡片，单项操作只更新该服饰在各视图中的副本。
  const cardsById = new Map();
  const toastStates = new WeakMap();
  let activeItemId;
  let panelTrigger;
  let panelNoticeTimer;
  let detailTrigger;
  let wardrobeDeleteTrigger;
  let pendingDeletion = new Set();
  let currentSlotId = 's1';
  let pickerFilterOwner = 'ALL';
  let pickerFilterCat = 'ALL';
  let currentSuitName = '雨夜执勤正装套组';

  const MODAL_MAP = {
    'open-cat-mgr': 'modalCatMgr',
    'open-combine-modal': 'modalCombine',
    'open-logs': 'modalLogs',
    'open-settings': 'modalSettings',
    'open-io': 'modalIO',
  };

  /** 按弹窗 ID 打开项目弹窗，清除上一次提交的提示。 */
  const openModal = id => {
    const dialog = $(id);
    clearModalToast(dialog);
    dialog.showModal();
  };

  /** 关闭指定或当前弹窗，取消设置时撤销预览，取消删除时回到原操作行。 */
  const closeModal = (dialog = wardrobeDeleteDialog.open ? wardrobeDeleteDialog : sh.querySelector('.backdrop[open]')) => {
    if (!dialog) return;
    if (dialog === settingsDialog) applySettings();
    clearModalToast(dialog);
    dialog.close();
    if (dialog === wardrobeDeleteDialog) {
      wardrobeDeleteTrigger.focus({ preventScroll: true });
      wardrobeDeleteTrigger = undefined;
    }
  };

  /** 清除指定弹窗的气泡、字段错误标记、定位监听和自动关闭计时器。 */
  const clearModalToast = dialog => {
    const toast = dialog.querySelector('.modal-toast');
    const { kind } = toast.dataset;
    if (!kind) return;
    const { field, stopTracking, timer } = toastStates.get(toast);
    stopTracking?.();
    field?.removeAttribute('aria-invalid');
    field?.removeAttribute('aria-errormessage');
    clearTimeout(timer);
    toastStates.delete(toast);
    toast.querySelector(kind === 'error' ? '[role="alert"]' : '[role="status"]').textContent = '';
    delete toast.dataset.kind;
    delete toast.dataset.anchored;
    delete toast.dataset.above;
    delete toast.dataset.offscreen;
  };

  /** 让气泡贴在指定弹窗的出错字段旁，返回清理定位监听及待执行帧的函数。 */
  const trackModalToast = (dialog, toast, field) => {
    const slot = toast.parentElement;
    const body = dialog.querySelector('.modal-b');
    const pane = field.closest('.settings-pane');
    const anchor = field.closest('.wardrobe-group-member') ?? field;
    const editor = field.closest('.wardrobe-group-members') ?? field;
    const controller = new P.AbortController();
    const options = { signal: controller.signal, passive: true };
    let frame = 0;

    /** 按滚动区和字段位置计算气泡坐标，字段滚出可见区时隐藏气泡。 */
    const position = () => {
      frame = 0;
      const rect = anchor.getBoundingClientRect();
      const bodyRect = body.getBoundingClientRect();
      const paneRect = pane?.getBoundingClientRect() ?? bodyRect;
      const top = Math.max(bodyRect.top, paneRect.top);
      const bottom = Math.min(bodyRect.bottom, paneRect.bottom);
      const offscreen = !rect.height || rect.top < top || rect.bottom > bottom;
      toast.toggleAttribute('data-offscreen', offscreen);
      if (offscreen) return;

      const slotRect = slot.getBoundingClientRect();
      const { width, height } = toast.getBoundingClientRect();
      const gap = 8;
      const below = rect.bottom + gap;
      const above = rect.top - height - gap;
      // 列表末行下方空间不足时翻到字段上方，避免遮住底栏按钮。
      const useAbove = below + height > bottom && above >= slot.parentElement.getBoundingClientRect().top + gap;
      const left = Math.max(slotRect.left + 10, Math.min(rect.left, slotRect.right - width - 10));
      const arrow = Math.max(10, Math.min(rect.left + Math.min(20, rect.width / 2) - left - 5, width - 20));
      toast.toggleAttribute('data-above', useAbove);
      toast.style.setProperty('--toast-top', `${(useAbove ? above : below) - slotRect.top}px`);
      toast.style.setProperty('--toast-left', `${left - slotRect.left}px`);
      toast.style.setProperty('--toast-arrow', `${arrow}px`);
    };

    /** 将同一帧内的滚动或缩放合并为一次定位，避免重复读写布局。 */
    const schedule = () => {
      if (!frame) frame = P.requestAnimationFrame(position);
    };
    dialog.addEventListener('scroll', schedule, { ...options, capture: true });
    P.addEventListener('resize', schedule, options);
    /** 用户开始修正当前字段时清除旧提示，由下次提交重新校验。 */
    editor.addEventListener('input', () => clearModalToast(dialog), options);
    position();
    /** 关闭气泡后释放定位监听，避免用旧字段覆盖下一次提示。 */
    return () => {
      controller.abort();
      P.cancelAnimationFrame(frame);
    };
  };

  /** 显示指定弹窗的消息。字段错误贴着控件，成功消息定时从底栏上方收起。 */
  const showModalToast = (dialog, message, kind, field) => {
    clearModalToast(dialog);
    const toast = dialog.querySelector('.modal-toast');
    const state = { field };
    toastStates.set(toast, state);
    toast.dataset.kind = kind;
    const copy = toast.querySelector(kind === 'error' ? '[role="alert"]' : '[role="status"]');
    copy.textContent = message;
    if (field) {
      field.setAttribute('aria-invalid', 'true');
      field.setAttribute('aria-errormessage', copy.id);
      toast.dataset.anchored = '';
      state.stopTracking = trackModalToast(dialog, toast, field);
    }
    if (kind === 'success') {
      state.timer = setTimeout(() => clearModalToast(dialog), 3500);
    }
  };

  /** 显示指定弹窗的错误消息，传入字段时将焦点移到可修正的位置。 */
  const showModalError = (dialog, message, field) => {
    field?.focus();
    showModalToast(dialog, message, 'error', field);
  };

  /** 将弹窗提交的变更与其余已保存数据写入同一快照，返回写入是否成功。 */
  const persistState = (dialog, {
    items = [...ITEMS_BY_ID.values()], nextSettings = settings, wardrobes = [...WARDROBES.values()], wardrobeGroups = [...WARDROBE_GROUPS.values()],
  } = {}) => {
    try {
      P.localStorage.setItem(STORAGE_KEY, JSON.stringify({ items, settings: nextSettings, wardrobes, wardrobeGroups }));
      clearModalToast(dialog);
      return true;
    } catch {
      showModalError(dialog, '无法写入浏览器存储，请检查存储权限或剩余空间后重试。');
      return false;
    }
  };

  /** 同步开关外观与辅助技术读到的状态。 */
  const setSettingSwitch = (field, enabled) => {
    field.classList.toggle('on', enabled);
    field.setAttribute('aria-checked', String(enabled));
  };

  /** 按给定衣柜填充下拉菜单，可选的提示项要求用户先选择一个目标。 */
  const fillWardrobeOptions = (select, wardrobes, placeholder) => {
    select.replaceChildren();
    if (placeholder) select.add(new P.Option(placeholder, ''));
    for (const { id, name } of wardrobes) select.add(new P.Option(name, id));
  };

  /** 同步衣柜下拉和存储统计。有组合时用不可选的小标题标明组合入口。 */
  const renderWardrobeOptions = () => {
    fillWardrobeOptions(wardrobeSelect, WARDROBES.values());
    if (WARDROBE_GROUPS.size) {
      // 将组合与单个衣柜放在同一层，避免浏览器给 optgroup 内的选项额外缩进。
      const heading = new P.Option(WARDROBE_GROUP_LABEL, '');
      heading.disabled = true;
      wardrobeSelect.add(heading);
      for (const { id, name } of WARDROBE_GROUPS.values()) {
        const option = new P.Option(name, id);
        option.setAttribute('aria-label', `${WARDROBE_GROUP_LABEL} ${name}`);
        wardrobeSelect.add(option);
      }
    }
    wardrobeSelect.value = wardrobeScope;
    $('statusWardrobe').textContent = wardrobeSelect.selectedOptions[0].textContent;
    const groupCount = WARDROBE_GROUPS.size ? ` · ${WARDROBE_GROUPS.size} 个组合` : '';
    $('storedWardrobeCount').textContent = `${WARDROBES.size} 个衣柜${groupCount}`;
  };

  /** 按衣柜与真实服饰数量生成一行管理控件，名称只作为文本和可访问标签显示。 */
  const wardrobeRowTpl = ({ id, name }, count) => {
    const label = escapeHTML(name);
    return `<div class="cfg-row wardrobe-row" data-wardrobe-id="${escapeHTML(id)}">
      <div class="wardrobe-label">
        <b class="wardrobe-name">${label}</b>
        <form class="action-row wardrobe-rename" novalidate hidden>
          <input class="inp" aria-label="衣柜名称">
          <button class="btn sm solid" type="submit">保存</button>
          <button class="btn sm" type="button" data-ui="wardrobe-cancel-rename">取消</button>
        </form>
        <small class="wardrobe-count">${count} 件</small>
      </div>
      <div class="action-row wardrobe-actions">
        ${actionBtn('wardrobe-rename', '重命名', 'sm')}
        ${actionBtn('wardrobe-view', '独立查看', 'sm')}
        <button class="btn sm danger" type="button" data-ui="wardrobe-delete" aria-label="删除衣柜 ${label}">删除</button>
      </div>
    </div>`;
  };

  /** 根据已保存组合生成查看与编辑入口，成员名称读取最新的衣柜记录。 */
  const renderWardrobeGroups = () => {
    wardrobeGroupList.hidden = !WARDROBE_GROUPS.size;
    wardrobeGroupList.innerHTML = Array.from(WARDROBE_GROUPS.values(), ({ id, name, wardrobeIds }) => `
      <div class="cfg-row wardrobe-row" data-group-id="${escapeHTML(id)}">
        <div class="wardrobe-label"><b>${escapeHTML(name)}</b><small>${wardrobeIds.map(key => escapeHTML(WARDROBES.get(key).name)).join(' · ')}</small></div>
        <div class="action-row wardrobe-actions">
          ${actionBtn('wardrobe-group-view', '查看', 'sm')}
          ${actionBtn('wardrobe-group-edit', '编辑', 'sm')}
          ${actionBtn('wardrobe-group-delete', '删除组合', 'sm danger')}
        </div>
      </div>`).join('');
  };

  /** 按指定已选 ID 填充组合的衣柜复选项。未传入时保留编辑中已勾选的成员。 */
  const renderWardrobeGroupMembers = (selected = new Set([...wardrobeGroupMembers.querySelectorAll(':checked')].map(input => input.value))) => {
    wardrobeGroupMembers.innerHTML = Array.from(WARDROBES.values(), ({ id, name }) => `
      <label class="wardrobe-group-member"><input type="checkbox" name="wardrobe" value="${escapeHTML(id)}"${selected.has(id) ? ' checked' : ''}><span>${escapeHTML(name)}</span></label>`).join('');
  };

  /** 打开组合编辑区并回填指定组合，省略组合参数时从空表单开始。 */
  const openWardrobeGroupEditor = group => {
    wardrobeGroupForm.dataset.groupId = group?.id ?? '';
    wardrobeGroupName.value = group?.name ?? '';
    renderWardrobeGroupMembers(new Set(group?.wardrobeIds));
    clearModalToast(wardrobeDialog);
    wardrobeGroupForm.hidden = false;
    wardrobeGroupName.focus();
  };

  /** 收起当前组合编辑区，将焦点还给新建入口。 */
  const closeWardrobeGroupEditor = () => {
    wardrobeGroupForm.hidden = true;
    clearModalToast(wardrobeDialog);
    wardrobeDialog.querySelector('[data-ui="wardrobe-group-new"]').focus();
  };

  /** 按完整库存重建衣柜列表，同步每个衣柜的真实件数。 */
  const renderWardrobeList = () => {
    const counts = new Map();
    for (const { wardrobeId } of ITEMS_BY_ID.values()) counts.set(wardrobeId, (counts.get(wardrobeId) ?? 0) + 1);
    wardrobeList.innerHTML = Array.from(WARDROBES.values(), wardrobe => wardrobeRowTpl(wardrobe, counts.get(wardrobe.id) ?? 0)).join('');
  };

  /** 打开管理弹窗，同步衣柜和组合列表后聚焦新衣柜输入。 */
  const openWardrobeManager = () => {
    renderWardrobeList();
    wardrobeGroupForm.hidden = true;
    renderWardrobeGroups();
    openModal('modalWardrobeMgr');
    createName.focus();
  };

  /** 保存一个新增或更新的衣柜。完整快照写入成功后才替换索引中的记录。 */
  const saveWardrobe = wardrobe => {
    const exists = WARDROBES.has(wardrobe.id);
    const wardrobes = Array.from(WARDROBES.values(), current => current.id === wardrobe.id ? wardrobe : current);
    if (!exists) wardrobes.push(wardrobe);
    if (!persistState(wardrobeDialog, { wardrobes })) return false;
    WARDROBES.set(wardrobe.id, wardrobe);
    renderWardrobeOptions();
    renderWardrobeGroups();
    if (!wardrobeGroupForm.hidden) renderWardrobeGroupMembers();
    return true;
  };

  /** 从指定行的删除按钮打开独立确认弹窗，说明服饰去向和受影响的组合。 */
  const openWardrobeDelete = trigger => {
    const { wardrobeId } = trigger.closest('.wardrobe-row').dataset;
    const target = WARDROBES.get(getDefaultWardrobeId(wardrobeId));
    if (!target) return;

    let itemCount = 0, updatedGroups = 0, removedGroups = 0;
    for (const item of ITEMS_BY_ID.values()) if (item.wardrobeId === wardrobeId) itemCount++;
    for (const { wardrobeIds } of WARDROBE_GROUPS.values()) {
      if (!wardrobeIds.includes(wardrobeId)) continue;
      if (wardrobeIds.length === 2) removedGroups++;
      else updatedGroups++;
    }

    const details = [];
    if (itemCount) details.push(`${itemCount} 件服饰将移到「${target.name}」。`);
    if (updatedGroups) details.push(`将从 ${updatedGroups} 个组合中移除此衣柜。`);
    if (removedGroups) details.push(`${removedGroups} 个组合将因少于两个衣柜而删除。`);
    wardrobeDeleteTrigger = trigger;
    $('wardrobeDeletePrompt').textContent = `确定删除「${WARDROBES.get(wardrobeId).name}」？`;
    const detailsText = $('wardrobeDeleteDetails');
    detailsText.textContent = details.join('');
    detailsText.hidden = !details.length;
    clearModalToast(wardrobeDialog);
    openModal('modalWardrobeDelete');
    // 默认聚焦取消，避免打开确认框后再次按 Enter 就删除衣柜。
    wardrobeDeleteDialog.querySelector('.modal-f [data-ui="close-modals"]').focus();
  };

  /** 按匹配函数生成移至目标衣柜的完整库存和变更记录，供一次保存后提交。 */
  const stageWardrobeMove = (wardrobeId, matches) => {
    const moved = [];
    const items = Array.from(ITEMS_BY_ID.values(), item => {
      if (item.wardrobeId === wardrobeId || !matches(item)) return item;
      const next = { ...item, wardrobeId };
      moved.push(next);
      return next;
    });
    return { items, moved };
  };

  /** 一次保存衣柜删除、迁移和组合更新，成功后就地更新管理列表。 */
  const deleteWardrobe = () => {
    if (!wardrobeDeleteTrigger) return;
    const row = wardrobeDeleteTrigger.closest('.wardrobe-row');
    const { wardrobeId } = row.dataset;
    const destinationId = getDefaultWardrobeId(wardrobeId);
    const { items, moved } = stageWardrobeMove(destinationId, item => item.wardrobeId === wardrobeId);
    const wardrobes = [...WARDROBES.values()].filter(wardrobe => wardrobe.id !== wardrobeId);
    const wardrobeGroups = [];
    for (const group of WARDROBE_GROUPS.values()) {
      const wardrobeIds = group.wardrobeIds.filter(id => id !== wardrobeId);
      // 组合至少包含两个衣柜。保留有效组合的原 ID，让现有下拉选择仍可用。
      if (wardrobeIds.length >= 2) wardrobeGroups.push({ ...group, wardrobeIds });
    }
    if (!persistState(wardrobeDeleteDialog, { items, wardrobes, wardrobeGroups })) return;

    const resetSelection = wardrobeScope === wardrobeId || WARDROBE_GROUPS.get(wardrobeScope)?.wardrobeIds.includes(wardrobeId);
    WARDROBES.delete(wardrobeId);
    for (const item of moved) ITEMS_BY_ID.set(item.id, item);
    WARDROBE_GROUPS.clear();
    for (const group of wardrobeGroups) WARDROBE_GROUPS.set(group.id, group);
    if (!WARDROBES.has(wardrobeScope) && !WARDROBE_GROUPS.has(wardrobeScope)) wardrobeScope = destinationId;

    // 保留其余行，避免滚动位置和编辑中的输入随列表重建一起丢失。
    const adjacent = row.nextElementSibling ?? row.previousElementSibling;
    closeModal(wardrobeDeleteDialog);
    row.remove();
    if (moved.length) {
      let count = 0;
      for (const item of items) if (item.wardrobeId === destinationId) count++;
      wardrobeList.querySelector(`[data-wardrobe-id="${P.CSS.escape(destinationId)}"] .wardrobe-count`).textContent = `${count} 件`;
    }
    renderWardrobeGroups();
    if (!wardrobeGroupForm.hidden) {
      const { groupId } = wardrobeGroupForm.dataset;
      if (groupId && !WARDROBE_GROUPS.has(groupId)) wardrobeGroupForm.hidden = true;
      else renderWardrobeGroupMembers();
    }
    renderWardrobeOptions();
    refreshWardrobeView(resetSelection);
    adjacent.querySelector(WARDROBES.size > 1 ? '[data-ui="wardrobe-delete"]' : '[data-ui="wardrobe-view"]').focus();
    showModalToast(wardrobeDialog, '衣柜已删除。', 'success');
  };

  /** 从指定输入校验衣柜或组合名称，返回去空白后的有效值，失败时显示本插件的错误。 */
  const readWardrobeName = (input, records, currentId, kind) => {
    const name = input.value.trim();
    let error;
    if (!name) error = `请输入${kind}名称。`;
    else if (Array.from(records.values()).some(record => record.id !== currentId && record.name === name)) error = `已存在同名${kind}。`;
    if (error) {
      showModalError(wardrobeDialog, error, input);
      return '';
    }
    return name;
  };

  /** 写入指定的组合更改。省略组合时删除该 ID，若正在查看则回到默认衣柜。 */
  const saveWardrobeGroup = (id, group) => {
    const next = new Map(WARDROBE_GROUPS);
    if (group) next.set(id, group);
    else next.delete(id);
    if (!persistState(wardrobeDialog, { wardrobeGroups: [...next.values()] })) return false;
    const previous = WARDROBE_GROUPS.get(id);
    if (group) WARDROBE_GROUPS.set(id, group);
    else WARDROBE_GROUPS.delete(id);
    const scopeChanged = wardrobeScope === id && (!group || previous.wardrobeIds.length !== group.wardrobeIds.length
      || previous.wardrobeIds.some((key, index) => key !== group.wardrobeIds[index]));
    if (!group && wardrobeScope === id) wardrobeScope = getDefaultWardrobeId();
    renderWardrobeGroups();
    renderWardrobeOptions();
    if (scopeChanged) refreshWardrobeView(true);
    return true;
  };

  /** 切换指定行的名称编辑状态，在打开和关闭时把焦点放回对应控件。 */
  const setWardrobeEditor = (row, editing) => {
    const label = row.querySelector('.wardrobe-name');
    const form = row.querySelector('.wardrobe-rename');
    const button = row.querySelector('[data-ui="wardrobe-rename"]');
    label.hidden = button.hidden = editing;
    form.hidden = !editing;
    clearModalToast(wardrobeDialog);
    if (editing) {
      const input = form.querySelector('input');
      input.value = label.textContent;
      input.focus();
      input.select();
    } else button.focus();
  };

  /** 打开服饰表单。查看组合时让用户在其成员中选择存放位置。 */
  const openAddOutfit = () => {
    const group = WARDROBE_GROUPS.get(wardrobeScope);
    const target = $('addWardrobe');
    if (group) {
      const previous = target.value;
      fillWardrobeOptions(target, group.wardrobeIds.map(id => WARDROBES.get(id)), '请选择衣柜');
      if (group.wardrobeIds.includes(previous)) target.value = previous;
    }
    target.disabled = target.parentElement.hidden = !group;
    openModal('modalAddOutfit');
  };

  /** 隐私开关可以即时预览，取消时由已保存的设置重新应用。 */
  const applyDisplay = (blurR18, showTags) => {
    gwrap.classList.toggle('blur-r18', blurR18);
    gwrap.classList.toggle('hide-tags', !showTags);
  };

  /** 把已保存的设置和默认值回填到控件，并同步画廊显示。 */
  function applySettings() {
    for (const field of settingsFields) {
      const value = settings[field.dataset.setting];
      if (field.matches('button')) setSettingSwitch(field, value !== false);
      else field.value = typeof value === 'string' ? value : field.defaultValue ?? field.options[0].value;
    }
    applyDisplay(settings.blurR18 !== false, settings.showTags !== false);
  }

  /** 校验并保存表单修改，保留原有字段。错误通过设置弹窗的提示卡片显示。 */
  const saveSettings = () => {
    const depthField = $('injectDepth');
    const depth = depthField.value.trim();
    if (depth && !/^\d+$/.test(depth)) {
      const tab = settingsDialog.querySelector('[data-pane="paneInject"]');
      switchPane(tab, SETTINGS_TABS, '.s-tab');
      showModalError(settingsDialog, '注入位置深度请输入 0 或正整数。', depthField);
      return;
    }
    const next = { ...settings };
    for (const field of settingsFields) {
      next[field.dataset.setting] = field.matches('button') ? field.classList.contains('on') : field.value;
    }
    next.injectDepth = depth;
    if (!persistState(settingsDialog, { nextSettings: next })) return;
    settings = next;
    closeModal();
  };

  /** 同步当前范围的勾选数量和批量移动入口，网格、列表与看板共用同一份选择。 */
  const updateBatchCount = () => {
    $('batchCount').textContent = String(batchIds.size);
    $('btnBatchMove').disabled = !batchIds.size;
  };

  const batchIds = new Set();

  /** 按全部服饰勾选或取消，并更新两种视图的勾选状态。 */
  const setBatchSelection = selected => {
    batchIds.clear();
    if (selected) for (const id of visibleItems.keys()) batchIds.add(id);
    for (const copies of cardsById.values()) for (const card of copies) syncCardCheck(card);
    updateBatchCount();
  };

  /** 根据卡片记录的服饰 ID 同步勾选外观和按下状态。 */
  const syncCardCheck = card => {
    const checked = batchIds.has(card.dataset.id);
    card.classList.toggle('batch-checked', checked);
    card.querySelector('[data-ui="card-check"]').setAttribute('aria-pressed', String(checked));
  };

  /** 切换指定服饰的勾选状态，更新它在画廊和看板里的副本。 */
  const toggleBatchItem = id => {
    if (batchIds.has(id)) batchIds.delete(id);
    else batchIds.add(id);
    for (const card of cardsById.get(id) ?? []) syncCardCheck(card);
    updateBatchCount();
  };

  /** 仅在触发控件的直接容器内，通过原有选择器更新激活状态。 */
  const activateWithin = (el, selector = 'button') => {
    el.parentElement.querySelectorAll(selector).forEach(button => button.classList.toggle('on', button === el));
  };

  /** 根据触发页签及对应配置切换内容区，保持其它页签组的状态。 */
  const switchPane = (el, tabs, selector) => {
    activateWithin(el, selector);
    for (const [id] of tabs) $(id).hidden = id !== el.dataset.pane;
  };

  /** 同步槽位卡片、已装备明细和套装描述，三处使用同一次槽位遍历的结果。 */
  const renderMatrixUI = () => {
    const slotCards = [], details = [], descriptions = [];
    for (const s of MATRIX_SLOTS) {
      const it = visibleItems.get(s.itemId);
      if (it) {
        details.push(cfgRowTpl(s.code, escapeHTML(it.title), `<button class="btn sm ghost" data-ui="matrix-slot" data-slot-id="${s.id}">更换</button>`));
        descriptions.push(`- ${s.tag}：${it.title}（${it.desc}）`);
      }
      slotCards.push(`
        <div class="m-slot ${it ? 'active' : 'empty'}" data-ui="matrix-slot" data-slot-id="${s.id}">
          <div class="m-slot-top">
            <span>${s.code}</span>
            <span class="${it ? 'st-on' : 'st-off'}">${it ? '已装备' : '空置'}</span>
          </div>
          <div class="m-slot-body">
            ${it ? `<img src="${escapeHTML(itemImage(it, s.tag))}" loading="lazy" decoding="async" alt="">` : `<span style="font-size:11.5px">${s.hint}</span>`}
            <div class="m-slot-hover">
              <span class="btn sm solid">${icon('hanger', 12)}${it ? '更换衣柜服饰' : '从衣柜选衣'}</span>
              ${it ? `<button class="btn sm danger" data-ui="slot-quick-clear" data-slot-id="${s.id}">${icon('trash', 12)}卸下</button>` : ''}
            </div>
          </div>
          <button type="button" class="m-slot-foot" aria-label="${s.code} · ${it ? escapeHTML(it.title) : s.emptyText}">${it ? escapeHTML(it.title) : s.emptyText}</button>
        </div>`);
    }
    const activeCount = details.length;
    $('topMatrixCount').textContent = `${activeCount} 槽`;
    $('matrixActiveBadge').textContent = `${activeCount} / ${MATRIX_SLOTS.length} 槽位`;
    $('suitPreviewName').textContent = `当前合成套装：${currentSuitName}`;
    $('suitPreviewSub').textContent = `共激活 ${activeCount} 个身体槽位，点击左侧槽位可随时更换或卸下服饰`;
    $('matrixGrid').innerHTML = slotCards.join('');
    $('matrixActiveList').innerHTML = activeCount
      ? details.join('')
      : `<div class="cfg-row"><small class="dim">当前未装备任何部位，请点击左侧槽位从衣柜选择衣服</small></div>`;

    $('matrixSynthPrompt').value = activeCount
      ? `【${currentSuitName}】\n${descriptions.join('\n')}`
      : '（当前未装备任何槽位）';
  };

  /** 用当前槽位及筛选条件刷新选衣网格，每次从数据对象读取最新标签。 */
  const renderSlotPickerGrid = () => {
    const slot = SLOTS_BY_ID.get(currentSlotId);
    const q = ($('pickerSearch')?.value || '').trim().toLowerCase();
    const items = [];
    for (const it of visibleItems.values()) {
      if (pickerFilterOwner !== 'ALL' && it.owner !== pickerFilterOwner) continue;
      if (pickerFilterCat !== 'ALL' && it.category !== pickerFilterCat) continue;
      if (q && !`${it.title} ${it.category} ${it.tags.join(' ')}`.toLowerCase().includes(q)) continue;
      items.push(it);
    }

    $('slotPickerGrid').innerHTML = items.length
      ? items.map(it => {
          const isEq = slot?.itemId === it.id;
          return `
            <button class="p-card ${isEq ? 'equipped' : ''}" data-ui="picker-select-item" data-item-id="${escapeHTML(it.id)}">
              <span class="p-thumb">
                <img src="${escapeHTML(itemImage(it, '正面视图'))}" loading="lazy" decoding="async" alt="">
                ${isEq ? '<span class="p-badge">当前槽位已穿</span>' : ''}
              </span>
              <span class="p-meta">
                <b>${escapeHTML(it.title)}</b>
                <small><span>${escapeHTML(it.category)}</span><span class="mono">${escapeHTML(it.rating)}</span></small>
              </span>
            </button>`;
        }).join('')
      : `<div style="grid-column:1/-1;padding:36px;text-align:center;color:var(--z500)">衣柜中没有找到匹配的服饰，可切换上方分类筛选或新建服饰</div>`;
  };

  /** 接收槽位 ID，打开对应的选衣弹窗，再按现有筛选状态填充候选卡片。 */
  const openSlotPicker = slotId => {
    currentSlotId = slotId;
    const slot = SLOTS_BY_ID.get(slotId);
    if (!slot) return;
    $('slotPickerTitle').textContent = `从衣柜选择服饰 · ${slot.code}`;
    $('modalSlotPicker').querySelector('[data-ui="slot-unequip-current"]').hidden = !visibleItems.has(slot.itemId);
    openModal('modalSlotPicker');
    // 与主面板一样，候选卡片在原生对话框完成聚焦后再参与布局。
    renderSlotPickerGrid();
  };

  $('pickerSearch').addEventListener('input', renderSlotPickerGrid, listenerOptions);

  const CHIP_FIELDS = {
    tag: { field: 'tags', target: 'inspChips', prefix: '#', label: '标签' },
    char: { field: 'boundChars', target: 'inspCharChips', prefix: '@', label: '人物' },
  };

  /** 按服饰和输入种类刷新标签或绑定人物，只有人物的空列表表示「全部」。 */
  const renderChips = (it, kind) => {
    const { field, target, prefix, label } = CHIP_FIELDS[kind];
    const removeTitle = kind === 'char' ? '移除绑定人物' : '移除标签';
    const values = it[field];
    const chips = values.map((value, index) =>
      `<span class="chip">${prefix}${escapeHTML(value)} <button data-ui="del-${kind}" data-idx="${index}" title="${removeTitle}">${icon('x', 10)}</button></span>`
    ).join('');
    const empty = kind === 'char' && !values.length ? '<span class="chip all-chip">全部</span>' : '';
    $(target).innerHTML = chips + empty + `<button class="chip-add" data-ui="toggle-${kind}-input">+ 添加${label}</button>`;
  };

  /** 按服饰的绑定状态刷新世界书开关、选择框和提示。 */
  const syncWbUI = it => {
    const enabled = !!it.wbEnabled;
    $('inspWbSw').classList.toggle('on', enabled);
    $('inspWorldbook').disabled = !enabled;
    $('inspWorldbook').value = enabled ? (it.boundWorldbook || '现代都市日常设定集') : '';
    $('wbSelectField').style.opacity = enabled ? '1' : '.55';
    $('wbStateHint').textContent = enabled ? '已启用 · 仅在激活该世界书时生效' : '当前默认关闭 · 不生效';
  };

  /** 在顶部、状态栏和侧栏同步指定的两组装备数量。 */
  const displayEquipCounts = (u, c) => {
    $('poolUserCount').textContent = `${u} 件`;
    $('poolCharCount').textContent = `${c} 件`;
    $('galleryEquippedUserCount').textContent = String(u);
    $('galleryEquippedCharCount').textContent = String(c);
    $('statusPoolText').textContent = `● 已装备候选: USER (${u}件) / Char (${c}件)`;
  };

  /** 装备状态变化时，仅重新汇总当前范围内的两个装备数量。 */
  const syncEquipCounts = () => {
    let u = 0, c = 0;
    for (const it of visibleItems.values()) {
      if (it.equippedUser) u++;
      if (it.equippedChar) c++;
    }
    displayEquipCounts(u, c);
  };

  /** 查看范围改变后，一次遍历汇总装备、归属、分类和收藏数，避免各栏分别扫描。 */
  const syncInventoryCounts = () => {
    const categoryCounts = new Map(CATEGORIES.map(({ name }) => [name, 0]));
    let equippedUser = 0, equippedChar = 0, user = 0, char = 0, favorite = 0, unsorted = 0;
    for (const item of visibleItems.values()) {
      if (item.equippedUser) equippedUser++;
      if (item.equippedChar) equippedChar++;
      if (item.owner === 'USER 玩家') user++;
      if (item.owner === 'Char 角色') char++;
      if (item.fav) favorite++;
      if (categoryCounts.has(item.category)) categoryCounts.set(item.category, categoryCounts.get(item.category) + 1);
      else unsorted++;
    }
    $('galleryAllCount').textContent = String(visibleItems.size);
    $('galleryUserCount').textContent = String(user);
    $('galleryCharCount').textContent = String(char);
    $('galleryFavoriteCount').textContent = String(favorite);
    $('galleryUnsortedCount').textContent = String(unsorted);
    CATEGORIES.forEach(({ name }, index) => {
      const count = categoryCounts.get(name);
      $(`galleryCategory${index}`).textContent = String(count);
      $(`categoryManagerCount${index}`).textContent = `${count} 件`;
    });
    displayEquipCounts(equippedUser, equippedChar);
  };

  /** 根据指定服饰刷新详情里的装备按钮，切换详情时可跳过全衣柜统计。 */
  const syncInspectorEquip = it => {
    for (const target of EQUIP_TARGETS) {
      const button = $(target.inspectorId);
      button.classList.toggle(`on-${target.slug}`, it[target.field]);
      button.innerHTML = inspectorEquipLabel(target, it[target.field]);
    }
  };

  /** 根据动作后缀返回装备对象配置，供单件和批量操作共用。 */
  const equipTarget = action => EQUIP_TARGETS[action.endsWith('-user') ? 0 : 1];

  /** 更新指定服饰的装备状态，仅刷新对应对象的标记和按钮。 */
  const setItemEquipped = (it, { slug, field }, equipped) => {
    it[field] = equipped;
    for (const card of cardsById.get(it.id) ?? []) {
      card.querySelector(`[data-role="badge-${slug}"]`).hidden = !equipped;
      card.querySelector(`[data-ui="toggle-eq-${slug}"]`).classList.toggle(`on-${slug}`, equipped);
    }
    if (it.id === activeItemId) syncInspectorEquip(it);
  };

  /** 切换指定服饰在动作所指向对象上的装备状态，并刷新界面。 */
  const toggleEquip = (it, action) => {
    if (!it) return;
    const target = equipTarget(action);
    setItemEquipped(it, target, !it[target.field]);
    syncEquipCounts();
  };

  /** 接收服饰 ID，切换详情数据并按其状态刷新交互控件。 */
  const selectCard = id => {
    const it = visibleItems.get(id);
    if (!it) return;
    // 只更新上次和本次选中的服饰，切换详情时无需扫描全部卡片。
    if (id !== activeItemId) {
      for (const card of cardsById.get(activeItemId) ?? []) card.classList.remove('on');
      for (const card of cardsById.get(id) ?? []) card.classList.add('on');
    }
    activeItemId = id;
    $('inspId').textContent = '#' + it.id;
    $('inspTitle').value = it.title;
    $('inspOwner').value = it.owner;
    $('inspCat').value = it.category;
    $('inspDesc').value = it.desc;
    $('inspImgFront').src = itemImage(it, '正面视图');
    $('inspImgBack').src = itemImage(it, '背面视图');
    $('inspRatingPicker').querySelectorAll('.rp-btn').forEach(b => b.classList.toggle('on', b.dataset.rating === it.rating));
    renderChips(it, 'tag');
    renderChips(it, 'char');
    syncWbUI(it);
    syncInspectorEquip(it);
  };

  /** 按需生成指定视图的卡片，并按服饰 ID 索引已挂载的副本。 */
  const renderInventoryView = view => {
    if (view.childElementCount) return;
    view.innerHTML = view === grid ? renderCardsHTML(activeItemId) : renderKanbanHTML(activeItemId);
    for (const card of view.querySelectorAll('.card')) {
      const id = card.dataset.id;
      const copies = cardsById.get(id);
      if (copies) copies.push(card);
      else cardsById.set(id, [card]);
    }
  };

  /** 首次打开或增删后刷新可见视图，隐藏视图和合并列表留到下次使用时生成。 */
  const renderInventory = () => {
    grid.replaceChildren();
    kanbanBoard.replaceChildren();
    cardsById.clear();
    renderInventoryView(grid.hidden ? kanbanBoard : grid);
    $('galleryInspector').hidden = !visibleItems.size;
    $('topGalleryCount').textContent = String(visibleItems.size);
    $('storedItemCount').textContent = `${ITEMS_BY_ID.size} 件`;
    $('combineList').replaceChildren();
    updateBatchCount();
    if (activeItemId) selectCard(activeItemId);
    syncInventoryCounts();
  };

  /** 从完整索引重建当前范围，并刷新所有依赖范围的视图。可同时退出旧详情并清空批量勾选。 */
  const refreshWardrobeView = (resetSelection = false) => {
    visibleItems.clear();
    // 组合成员一次建索引，衣柜数量增加时仍只遍历全量服饰一次。
    const inScope = new Set(WARDROBE_GROUPS.get(wardrobeScope)?.wardrobeIds ?? [wardrobeScope]);
    for (const [id, item] of ITEMS_BY_ID) {
      if (inScope.has(item.wardrobeId)) visibleItems.set(id, item);
    }
    if (resetSelection) batchIds.clear();
    if (resetSelection || !visibleItems.has(activeItemId)) {
      panel.classList.remove('detail-open');
      detailTrigger = null;
      for (const kind of Object.keys(CHIP_FIELDS)) {
        $(`${kind}Inline`).hidden = true;
        $(`${kind}Input`).value = '';
      }
    }
    if (!visibleItems.has(activeItemId)) activeItemId = visibleItems.keys().next().value;
    renderInventory();
    renderMatrixUI();
  };

  /** 按 ID 切换到已保存组合或单个衣柜，同步状态和各工作区的范围。 */
  const selectWardrobeScope = scope => {
    if (!WARDROBE_GROUPS.has(scope) && !WARDROBES.has(scope)) return;
    if (wardrobeScope !== scope) {
      wardrobeScope = scope;
      wardrobeSelect.value = scope;
      $('statusWardrobe').textContent = wardrobeSelect.selectedOptions[0].textContent;
      refreshWardrobeView(true);
    }
  };

  /** 从下拉切换当前面板查看的衣柜范围。 */
  wardrobeSelect.addEventListener('change', () => {
    selectWardrobeScope(wardrobeSelect.value);
  }, listenerOptions);

  /** 首次打开合并弹窗时生成候选项，保留再次打开时的勾选；服饰增删后按默认项重建。 */
  const renderCombineList = () => {
    const list = $('combineList');
    if (list.childElementCount) return;
    list.innerHTML = Array.from(visibleItems.values(), (it, index) =>
      `<div class="combine-item ${index === 0 || index === 2 || index === 5 ? 'on' : ''}" data-ui="combine-pick"><img src="${escapeHTML(itemImage(it, '正面视图'))}" loading="lazy" decoding="async" alt=""><div class="combine-item-info"><b>${escapeHTML(it.title)}</b><small>${escapeHTML(it.category)} · ${escapeHTML(it.rating)}</small></div></div>`
    ).join('');
    syncCombineCount();
  };

  /** 从合并候选的选中标记回填数量，空衣柜同时显示零个候选。 */
  const syncCombineCount = () => {
    $('combineCount').textContent = `已选 ${$('combineList').querySelectorAll('.combine-item.on').length} 件单品`;
  };

  /** 收起窄屏服饰详情，把焦点归还原卡片或当前视图的新建入口。 */
  const closeDetail = () => {
    panel.classList.remove('detail-open');
    const visibleView = grid.hidden ? kanbanBoard : grid;
    const target = detailTrigger?.isConnected ? detailTrigger : visibleView.querySelector('.card.on .cmeta-t');
    (target ?? visibleView.querySelector('.card-add, .kb-add') ?? closePanelButton).focus();
  };

  /** 从新增表单读取并校验数据，成功写入后刷新服饰入口。 */
  addOutfitForm.addEventListener('submit', event => {
    event.preventDefault();
    const dialog = $('modalAddOutfit');
    const group = WARDROBE_GROUPS.get(wardrobeScope);
    const target = $('addWardrobe');
    const wardrobeId = group ? target.value : wardrobeScope;
    if (group && !group.wardrobeIds.includes(wardrobeId)) {
      showModalError(dialog, '请选择存入组合中的哪个衣柜。', target);
      return;
    }
    const title = $('addTitle').value.trim();
    if (!title) {
      showModalError(dialog, '请输入服饰标题。', $('addTitle'));
      return;
    }
    const frontUrl = $('addFront').value.trim();
    const backUrl = $('addBack').value.trim();
    for (const [id, value] of [['addFront', frontUrl], ['addBack', backUrl]]) {
      if (value && !isImageUrl(value)) {
        showModalError(dialog, '请输入完整的 HTTP 或 HTTPS 图片链接。', $(id));
        return;
      }
    }
    const it = {
      id: 'WD-' + P.crypto.getRandomValues(new Uint32Array(2)).join('-'),
      wardrobeId,
      title,
      owner: $('addOwner').value,
      category: $('addCategory').value,
      rating: $('addRatingPicker').querySelector('.on').dataset.rating,
      desc: $('addDesc').value.trim(),
      tags: [...new Set($('addTags').value.split(/[\s,，]+/).map(tag => tag.replace(/^#/, '')).filter(Boolean))],
      frontUrl,
      backUrl,
      equippedUser: event.submitter?.value === 'equippedUser',
      equippedChar: event.submitter?.value === 'equippedChar',
      fav: false,
      wbEnabled: false,
      boundWorldbook: '',
      boundChars: [],
    };
    if (!persistState(dialog, { items: [...ITEMS_BY_ID.values(), it] })) return;
    ITEMS_BY_ID.set(it.id, it);
    activeItemId = it.id;
    addOutfitForm.reset();
    activateWithin($('addRatingPicker').querySelector('.rp-btn'), '.rp-btn');
    closeModal();
    refreshWardrobeView();
    const view = grid.hidden ? kanbanBoard : grid;
    const focusTarget = $('wsGallery').hidden ? $('wsMatrix').querySelector('.m-slot-foot') : view.querySelector('.card.on .cmeta-t');
    (focusTarget ?? closePanelButton).focus();
  }, listenerOptions);

  /** 读取组合表单，校验名称和最少成员数，再保存新组合或更新原组合。 */
  wardrobeGroupForm.addEventListener('submit', event => {
    event.preventDefault();
    const currentId = wardrobeGroupForm.dataset.groupId;
    const name = readWardrobeName(wardrobeGroupName, WARDROBE_GROUPS, currentId, '组合');
    if (!name) return;
    const wardrobeIds = new P.FormData(wardrobeGroupForm).getAll('wardrobe');
    if (wardrobeIds.length < 2) {
      showModalError(wardrobeDialog, '请至少选择两个衣柜。', wardrobeGroupMembers.querySelector('input'));
      return;
    }
    const id = currentId || 'wg-' + P.crypto.getRandomValues(new Uint32Array(2)).join('-');
    if (saveWardrobeGroup(id, { id, name, wardrobeIds })) {
      closeWardrobeGroupEditor();
      showModalToast(wardrobeDialog, currentId ? '组合已更新。' : '组合已创建。', 'success');
    }
  }, listenerOptions);

  /** 提交新增或重命名。提交成功才改管理行，失败时保留用户输入和原有名称。 */
  wardrobeDialog.addEventListener('submit', event => {
    event.preventDefault();
    if (event.target === wardrobeGroupForm) return;
    const row = event.target.closest('.wardrobe-row');
    const input = event.target.querySelector('input');
    const id = row?.dataset.wardrobeId;
    const name = readWardrobeName(input, WARDROBES, id, '衣柜');
    if (!name) return;
    if (!row) {
      const wardrobe = { id: 'wb-' + P.crypto.getRandomValues(new Uint32Array(2)).join('-'), name };
      if (!saveWardrobe(wardrobe)) return;
      wardrobeList.insertAdjacentHTML('beforeend', wardrobeRowTpl(wardrobe, 0));
      input.value = '';
      input.focus();
      showModalToast(wardrobeDialog, '衣柜已添加。', 'success');
      return;
    }
    const wardrobe = WARDROBES.get(id);
    const renamed = wardrobe.name !== name;
    if (renamed) {
      if (!saveWardrobe({ ...wardrobe, name })) return;
      row.querySelector('.wardrobe-name').textContent = name;
      row.querySelector('[data-ui="wardrobe-delete"]').setAttribute('aria-label', `删除衣柜 ${name}`);
    }
    setWardrobeEditor(row, false);
    if (renamed) showModalToast(wardrobeDialog, '衣柜已重命名。', 'success');
  }, listenerOptions);

  /** 将选中的服饰一次写入目标衣柜，保存成功后才更新索引和清空勾选。 */
  $('batchMoveForm').addEventListener('submit', event => {
    event.preventDefault();
    if (!batchIds.size) return;
    const target = $('batchWardrobe');
    const wardrobeId = target.value;
    if (!WARDROBES.has(wardrobeId)) {
      showModalError(batchMoveDialog, '请选择目标衣柜。', target);
      return;
    }
    const { items, moved } = stageWardrobeMove(wardrobeId, item => batchIds.has(item.id));
    if (moved.length && !persistState(batchMoveDialog, { items })) return;
    for (const item of moved) ITEMS_BY_ID.set(item.id, item);
    closeModal();
    refreshWardrobeView(true);
    $('btnToggleBatch').focus();
  }, listenerOptions);

  /** 固定本次删除的服饰 ID，并展示确认内容。 */
  const openDelete = ids => {
    if (!ids.size) return;
    pendingDeletion = new Set(ids);
    $('deletePrompt').textContent = ids.size === 1
      ? `确定删除「${ITEMS_BY_ID.get(ids.values().next().value).title}」？`
      : `确定删除选中的 ${ids.size} 件服饰？`;
    openModal('modalConfirm');
  };

  /** 保存删除结果后同步列表、槽位和详情，同时将焦点移到可继续操作的控件。 */
  const deleteItems = () => {
    const remaining = [];
    for (const item of ITEMS_BY_ID.values()) if (!pendingDeletion.has(item.id)) remaining.push(item);
    if (!persistState($('modalConfirm'), { items: remaining })) return;
    for (const id of pendingDeletion) {
      ITEMS_BY_ID.delete(id);
      batchIds.delete(id);
    }
    for (const slot of MATRIX_SLOTS) if (pendingDeletion.has(slot.itemId)) slot.itemId = null;
    closeModal();
    panel.classList.remove('detail-open');
    detailTrigger = null;
    refreshWardrobeView();
    if (gwrap.classList.contains('batch-mode')) $('btnToggleBatch').focus();
    else closeDetail();
  };

  applySettings();

  /** 切换指定种类的行内输入框，并在打开时聚焦。 */
  const toggleChipInput = kind => {
    const row = $(`${kind}Inline`);
    row.hidden = !row.hidden;
    if (!row.hidden) $(`${kind}Input`).focus();
  };

  /** 提交指定种类的输入，沿用各自的前缀和重复提交后的刷新时机。 */
  const commitChip = kind => {
    const { field, prefix } = CHIP_FIELDS[kind];
    const it = ITEMS_BY_ID.get(activeItemId);
    const input = $(`${kind}Input`);
    const raw = input.value.trim();
    const value = raw.startsWith(prefix) ? raw.slice(1) : raw;
    if (it && value) {
      const exists = it[field].includes(value);
      if (!exists) it[field].push(value);
      if (!exists || kind === 'char') renderChips(it, kind);
    }
    input.value = '';
    $(`${kind}Inline`).hidden = true;
  };

  for (const kind of Object.keys(CHIP_FIELDS)) {
    /** 处理输入框的 Enter 键，与确认按钮共用提交逻辑。 */
    $(`${kind}Input`).addEventListener('keydown', e => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      commitChip(kind);
    }, listenerOptions);
  }

  /** 处理 Shadow DOM 点击事件，面板内的手动操作独立于插件开关。 */
  sh.addEventListener('click', e => {
    if (e.target.matches?.('.backdrop')) return closeModal();
    const el = e.target.closest('[data-ui]');
    if (!el) return;
    const act = el.dataset.ui;

    if (act === 'fab-toggle-plugin') {
      setPluginEnabled(!pluginEnabled);
      return;
    }
    if (act === 'fab-open-wardrobe') {
      open(fabBall);
      return;
    }
    if (MODAL_MAP[act]) {
      e.stopPropagation();
      openModal(MODAL_MAP[act]);
      if (act === 'open-combine-modal') renderCombineList();
      return;
    }

    const curItem = visibleItems.get(activeItemId);

    switch (act) {
      case 'close':
        close();
        break;
      case 'close-modals':
        closeModal();
        break;
      case 'dismiss-toast': {
        const dialog = el.closest('.backdrop');
        dialog.querySelector('.modal-h [data-ui="close-modals"]').focus({ preventScroll: true });
        clearModalToast(dialog);
        break;
      }
      case 'save-settings':
        saveSettings();
        break;
      case 'open-wardrobe-mgr':
        openWardrobeManager();
        break;
      case 'open-add-modal':
        openAddOutfit();
        break;
      case 'open-batch-move':
        if (batchIds.size) {
          fillWardrobeOptions($('batchWardrobe'), WARDROBES.values(), '请选择目标衣柜');
          openModal('modalBatchMove');
        }
        break;
      case 'wardrobe-rename':
      case 'wardrobe-cancel-rename':
        setWardrobeEditor(el.closest('.wardrobe-row'), act === 'wardrobe-rename');
        break;
      case 'wardrobe-view':
        selectWardrobeScope(el.closest('.wardrobe-row').dataset.wardrobeId);
        closeModal();
        wardrobeSelect.focus();
        break;
      case 'wardrobe-delete':
        openWardrobeDelete(el);
        break;
      case 'wardrobe-delete-confirm':
        deleteWardrobe();
        break;
      case 'wardrobe-group-new':
        openWardrobeGroupEditor();
        break;
      case 'wardrobe-group-cancel':
        closeWardrobeGroupEditor();
        break;
      case 'wardrobe-group-edit':
        openWardrobeGroupEditor(WARDROBE_GROUPS.get(el.closest('.wardrobe-row').dataset.groupId));
        break;
      case 'wardrobe-group-view':
        selectWardrobeScope(el.closest('.wardrobe-row').dataset.groupId);
        closeModal();
        wardrobeSelect.focus();
        break;
      case 'wardrobe-group-delete': {
        const { groupId } = el.closest('.wardrobe-row').dataset;
        if (saveWardrobeGroup(groupId)) {
          if (wardrobeGroupForm.dataset.groupId === groupId) closeWardrobeGroupEditor();
          else wardrobeDialog.querySelector('[data-ui="wardrobe-group-new"]').focus();
          showModalToast(wardrobeDialog, '组合已删除。', 'success');
        }
        break;
      }
      case 'open-item-delete':
        if (curItem) openDelete(new Set([curItem.id]));
        break;
      case 'open-batch-delete':
        openDelete(batchIds);
        break;
      case 'delete-items':
        deleteItems();
        break;
      case 'switch-ws': {
        const isMatrix = el.dataset.ws === 'matrix';
        activateWithin(el, '.ws-tab');
        for (const button of el.parentElement.children) button.setAttribute('aria-pressed', String(button === el));
        $('wsGallery').hidden = isMatrix;
        $('wsMatrix').hidden = !isMatrix;
        break;
      }

      // 槽位选衣
      case 'matrix-slot':
        openSlotPicker(el.dataset.slotId);
        break;
      case 'slot-quick-clear': {
        e.stopPropagation();
        const slot = SLOTS_BY_ID.get(el.dataset.slotId);
        if (slot) { slot.itemId = null; renderMatrixUI(); }
        break;
      }
      case 'matrix-clear-all':
        MATRIX_SLOTS.forEach(s => (s.itemId = null));
        renderMatrixUI();
        break;
      case 'picker-owner':
        pickerFilterOwner = el.dataset.owner;
        activateWithin(el);
        renderSlotPickerGrid();
        break;
      case 'picker-cat':
        pickerFilterCat = el.dataset.cat;
        activateWithin(el);
        renderSlotPickerGrid();
        break;
      case 'picker-select-item':
      case 'slot-unequip-current': {
        const slot = SLOTS_BY_ID.get(currentSlotId);
        if (slot) {
          slot.itemId = act === 'picker-select-item' ? el.dataset.itemId : null;
          closeModal();
          renderMatrixUI();
          $('matrixGrid').querySelector(`[data-slot-id="${slot.id}"] .m-slot-foot`).focus();
        }
        break;
      }
      case 'slot-to-add-new':
        closeModal();
        openAddOutfit();
        break;
      case 'suit-preset': {
        activateWithin(el, '.nav');
        const preset = PRESET_SUITS.find(s => s.id === el.dataset.id);
        if (preset) {
          currentSuitName = preset.name;
          MATRIX_SLOTS.forEach(s => { s.itemId = preset.slots[s.id] || null; });
          renderMatrixUI();
        }
        break;
      }

      case 'view-mode': {
        const mode = el.dataset.mode;
        renderInventoryView(mode === 'kanban' ? kanbanBoard : grid);
        activateWithin(el);
        if (mode === 'kanban') {
          grid.hidden = true;
          kanbanBoard.hidden = false;
        } else {
          kanbanBoard.hidden = true;
          grid.hidden = false;
          grid.classList.toggle('list', mode === 'list');
        }
        break;
      }
      case 'insp-tab':
        switchPane(el, INSPECTOR_TABS, '.insp-tab');
        break;
      case 'toggle-wb-enable':
        if (curItem) {
          curItem.wbEnabled = !curItem.wbEnabled;
          syncWbUI(curItem);
        }
        break;
      case 'toggle-char-input':
      case 'toggle-tag-input':
        toggleChipInput(act === 'toggle-tag-input' ? 'tag' : 'char');
        break;
      case 'add-char-confirm':
      case 'add-tag-confirm':
        commitChip(act === 'add-tag-confirm' ? 'tag' : 'char');
        break;
      case 'del-char':
      case 'del-tag':
        if (curItem) {
          const kind = act === 'del-tag' ? 'tag' : 'char';
          curItem[CHIP_FIELDS[kind].field].splice(Number(el.dataset.idx), 1);
          renderChips(curItem, kind);
        }
        break;
      case 'toggle-blur-r18':
        setSettingSwitch(el, !el.classList.contains('on'));
        gwrap.classList.toggle('blur-r18', el.classList.contains('on'));
        break;
      case 'toggle-show-tags':
        setSettingSwitch(el, !el.classList.contains('on'));
        gwrap.classList.toggle('hide-tags', !el.classList.contains('on'));
        break;
      case 'open-lightbox': {
        e.stopPropagation();
        $('lbTitle').textContent = `${curItem.title} · 正背面视图对照`;
        $('lbImgFront').src = itemImage(curItem, '正面视图');
        $('lbImgBack').src = itemImage(curItem, '背面视图');
        openModal('modalLightbox');
        break;
      }
      case 'toggle-batch-mode': {
        const on = gwrap.classList.toggle('batch-mode');
        gwrapBar.hidden = !on;
        $('btnToggleBatch').classList.toggle('on', on);
        if (!on) setBatchSelection(false);
        break;
      }
      case 'card-check':
        e.stopPropagation();
        toggleBatchItem(el.closest('.card').dataset.id);
        break;
      case 'batch-select-all':
      case 'batch-clear':
        setBatchSelection(act === 'batch-select-all');
        break;
      case 'batch-eq-user':
      case 'batch-eq-char': {
        const target = equipTarget(act);
        for (const id of batchIds) {
          const item = visibleItems.get(id);
          if (!item[target.field]) setItemEquipped(item, target, true);
        }
        syncEquipCounts();
        break;
      }
      case 'toggle-fav': {
        e.stopPropagation();
        const item = visibleItems.get(el.closest('.card').dataset.id);
        item.fav = !item.fav;
        // 只变动一件服饰的收藏状态，直接更新计数以免重新遍历衣柜。
        const count = $('galleryFavoriteCount');
        count.textContent = String(Number(count.textContent) + (item.fav ? 1 : -1));
        for (const card of cardsById.get(item.id) ?? []) {
          const favorite = card.querySelector('[data-ui="toggle-fav"]');
          favorite.classList.toggle('fav', item.fav);
          favorite.setAttribute('aria-pressed', String(item.fav));
        }
        break;
      }
      case 'toggle-eq-user':
      case 'toggle-eq-char':
        e.stopPropagation();
        toggleEquip(visibleItems.get(el.closest('.card')?.dataset.id), act);
        break;
      case 'insp-toggle-eq-user':
      case 'insp-toggle-eq-char':
        toggleEquip(curItem, act);
        break;
      case 'combine-pick':
        el.classList.toggle('on');
        syncCombineCount();
        break;
      case 'switch':
        if (el.dataset.setting) setSettingSwitch(el, !el.classList.contains('on'));
        else el.classList.toggle('on');
        break;
      case 'cfg-tab':
        clearModalToast(settingsDialog);
        switchPane(el, SETTINGS_TABS, '.s-tab');
        break;
      case 'card':
        if (gwrap.classList.contains('batch-mode')) {
          toggleBatchItem(el.dataset.id);
          break;
        }
        selectCard(el.dataset.id);
        detailTrigger = el.querySelector('.cmeta-t');
        panel.classList.add('detail-open');
        if (narrowLayout.matches) backButton.focus();
        break;
      case 'close-detail':
        closeDetail();
        break;
      case 'owner-tab':
      case 'nav':
      case 'seg':
      case 'rp':
      case 'tag-filter':
        activateWithin(el, `[data-ui="${act}"]`);
        break;
    }
  }, listenerOptions);

  /** 响应 Esc，关闭最上层弹窗或当前详情。 */
  sh.addEventListener('cancel', event => {
    event.preventDefault();
    if (event.target !== panel) closeModal(event.target);
    else if (narrowLayout.matches && !$('wsGallery').hidden && panel.classList.contains('detail-open')) closeDetail();
    else close();
  }, { ...listenerOptions, capture: true });

  /** 打开衣柜面板并记录焦点归还的触发控件，插件关闭时在面板内显示短暂提示。 */
  function open(trigger = sh.activeElement ?? PD.activeElement) {
    if (panel.open) return;
    if (trigger === fabBall) setFabMenu(false);
    panelTrigger = trigger;
    overlay.hidden = false;
    panel.showModal();
    closePanelButton.focus();
    if (!pluginEnabled) {
      panelOpenNotice.textContent = '衣柜插件已关闭';
      panelNoticeTimer = setTimeout(clearPanelNotice, 3500);
    }
    // 原生模态框先完成聚焦，再填充卡片，避免聚焦阶段同步布局整座画廊。
    if (!grid.childElementCount && !kanbanBoard.childElementCount) {
      renderWardrobeOptions();
      refreshWardrobeView();
    }
  }

  /** 自动消失、关闭面板或开启插件时清除提示，避免影响下次打开。 */
  function clearPanelNotice() {
    clearTimeout(panelNoticeTimer);
    panelNoticeTimer = undefined;
    panelOpenNotice.textContent = '';
  }

  /** 关闭面板与子弹窗，将焦点归还可用的入口。 */
  function close() {
    if (!panel.open) return;
    clearPanelNotice();
    if (wardrobeDeleteDialog.open) closeModal(wardrobeDeleteDialog);
    closeModal();
    panel.close();
    overlay.hidden = true;
    if (panelTrigger?.isConnected) panelTrigger.focus();
  }

  // 魔法棒菜单
  let menuItem, menuTimer;

  /** 插件启用期间，酒馆扩展菜单出现或重建时挂载当前实例的入口。 */
  const ensureMenuItem = () => {
    if (!pluginEnabled) return;
    const menu = PD.querySelector('#extensionsMenu');
    if (!menu || PD.getElementById('wardrobe-menu-item')) return;
    if (!menuItem) {
      menuItem = PD.createElement('button');
      menuItem.type = 'button';
      menuItem.id = 'wardrobe-menu-item';
      menuItem.className = 'list-group-item flex-container flexGap5 interactable';
      menuItem.innerHTML = '<span class="fa-solid fa-shirt extensionsMenuExtensionButton" aria-hidden="true"></span><span>衣柜面板</span>';
      /** 记住酒馆菜单按钮，让点击或键盘激活后的焦点都能恢复。 */
      menuItem.addEventListener('click', () => open(menuItem), listenerOptions);
    }
    menu.appendChild(menuItem);
  };

  /** 同步悬浮球状态和酒馆扩展菜单。关闭时停止入口轮询，悬浮球仍可打开衣柜。 */
  const applyPluginEnabled = () => {
    $('fabDot').classList.toggle('off', !pluginEnabled);
    const badge = $('fabPluginState');
    badge.textContent = pluginEnabled ? '已开启' : '已关闭';
    badge.classList.toggle('off', !pluginEnabled);
    fabMenu.querySelector('[data-ui="fab-toggle-plugin"]').setAttribute('aria-pressed', String(pluginEnabled));
    if (pluginEnabled) {
      clearPanelNotice();
      ensureMenuItem();
      menuTimer ??= setInterval(ensureMenuItem, 2000);
    } else {
      clearInterval(menuTimer);
      menuTimer = undefined;
      menuItem?.remove();
    }
  };

  /** 应用指定启停状态并尝试保存，存储不可用时仍让本页的开关生效。 */
  const setPluginEnabled = enabled => {
    pluginEnabled = enabled;
    applyPluginEnabled();
    try {
      P.localStorage.setItem(ENABLED_KEY, String(enabled));
      $('fabPluginError').hidden = true;
    } catch {
      $('fabPluginError').hidden = false;
    }
  };

  /** 释放本实例的计时器、监听及宿主节点；旧实例只清理自己发布的全局对象。 */
  const dispose = () => {
    clearInterval(menuTimer);
    close();
    listeners.abort();
    menuItem?.remove();
    host.remove();
    if (P.WardrobePanel === api) delete P.WardrobePanel;
  };

  const api = { open, close };
  applyPluginEnabled();
  host.addEventListener('wardrobe:dispose', dispose, listenerOptions);
  /** 根据页面离开事件清理插件。进入后退缓存时保留实例，因为恢复页面时脚本不会再次执行。 */
  window.addEventListener('pagehide', event => {
    if (!event.persisted) dispose();
  }, listenerOptions);
  P.WardrobePanel = api;
  console.info('[甄心甄意·衣柜] 已加载');
})();
